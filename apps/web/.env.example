# ─────────────────────────────────────────────────────────────
# Inflio — environment variables
# Copy to `.env.local` for local dev, and set the same keys in the
# Vercel project settings for production (inflio.in).
# ─────────────────────────────────────────────────────────────

# ── Convex (data layer: creators, campaigns, brands) ──────────
# Created by `npx convex dev` (dev) or `npx convex deploy` (prod).
# `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL + CONVEX_DEPLOYMENT here automatically.
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment"

# ── App URL (used by Better Auth for cookies + OAuth redirects) ─
# Local:      http://localhost:3000
# Production: https://www.inflio.in   <-- MUST be set on Vercel, or auth cookies break
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth database (Better Auth → Postgres) ────────────────────
# Managed Postgres connection string (Neon / Supabase / etc).
# After setting this, create the auth tables once with:
#   npx @better-auth/cli migrate
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Google OAuth (Sign in with Google) ────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI (production):
#   https://www.inflio.in/api/auth/callback/google
# Authorized redirect URI (local):
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Resend (transactional email — OTP codes) ──────────────────
# Optional for basic email+password login. Required for email-OTP sign-in.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
